# ==============================================================================
# Brave Origin + KasmVNC Environment Configuration
# ==============================================================================

# Host Persistent Storage Path (Local directory or Unraid appdata share)
CONFIG_PATH=./appdata
# Example for Unraid deployments:
# CONFIG_PATH=/mnt/user/appdata/brave-origin

# Stable Container Hostname
CONTAINER_HOSTNAME=brave-origin

# User ID and Group ID mapping to match host permissions on CONFIG_PATH
# Unraid defaults: PUID=99, PGID=100. Standard Linux/Docker defaults: PUID=1000, PGID=1000
PUID=1000
PGID=1000
UMASK=022

# Container Timezone (e.g. America/New_York, Europe/London, Asia/Tokyo, UTC)
TZ=America/New_York

# KasmVNC HTTPS Web Port on the host (navigate to https://localhost:8443)
WEB_PORT=8443

# Virtual Desktop Display Resolution
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# Automatic Brave Origin Updates
# When true, checks for updates at startup and periodically while running
AUTO_UPDATE=true
# Normal update check interval in seconds (21600 = 6 hours)
UPDATE_INTERVAL=21600
# Downgrade recovery retry interval in seconds when launch is paused (300 = 5 minutes)
DOWNGRADE_RETRY_INTERVAL=300

# Minimum Free Root Filesystem Space in MB required to start an upgrade (safety floor)
MIN_UPDATE_FREE_SPACE_MB=1024

# Browser Startup Stabilization Timeout in seconds (default: 15)
BRAVE_STARTUP_TIMEOUT=15

# Brave Origin Version Pinning
# 'latest' tracks the latest official stable release. Set to a specific version (e.g. 1.93.136) to pin.
BRAVE_ORIGIN_VERSION=latest

# Hardware Acceleration & Subsystem Toggles
# Note: Enabling GPU on Linux/Unraid also requires passing /dev/dri via compose.gpu.yaml
ENABLE_GPU=true
ENABLE_AUDIO=true
DRI_NODE=/dev/dri/renderD128

# Optional extra command-line flags passed directly to Brave Origin
# Example: BRAVE_FLAGS="--incognito --force-dark-mode"
BRAVE_FLAGS=
