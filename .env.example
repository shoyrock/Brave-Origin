# ==============================================================================
# Brave Origin in Docker - Environment Configuration
# ==============================================================================

# --- Primary Configuration ---
CONFIG_PATH=./appdata
PUID=1000
PGID=1000
TZ=America/New_York
WEB_PORT=8443
ENABLE_AUDIO=true
KASM_AUTH_ENABLED=false
AUTO_UPDATE=true

# --- Authentication Settings (Active when KASM_AUTH_ENABLED=true) ---
# KASM_USER=brave
# KASM_PASSWORD=YourSecurePassword123!
# KASM_PASSWORD_FILE=/run/secrets/kasm_password

# --- Advanced Settings (Optional Defaults) ---
# UMASK=022
# DISPLAY_WIDTH=1920
# DISPLAY_HEIGHT=1080
# CONTAINER_HOSTNAME=brave-origin
# BRAVE_ORIGIN_VERSION=latest
# BRAVE_FLAGS=
# DRI_NODE=/dev/dri/renderD128
# ENABLE_GPU=true
# UPDATE_INTERVAL=21600
# DOWNGRADE_RETRY_INTERVAL=300
# MIN_UPDATE_FREE_SPACE_MB=1024
# BRAVE_STARTUP_TIMEOUT=15
